# ============================================
# AI Health Trainer - .gitignore
# ============================================

# ── 환경변수 (절대 커밋 금지!) ──
.env
.env.prod
.env.local
.env.production
.env.staging
*.env
backend/.env

# ── Python ──
__pycache__/
*.pyc
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.Python
pip-log.txt
pip-delete-this-directory.txt

# Python 가상환경
venv/
.venv/
env/
ENV/

# pytest
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# mypy
.mypy_cache/

# ── Flutter / Dart ──
# Flutter 빌드 아티팩트
frontend/.dart_tool/
.dart_tool/
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# iOS/Android 빌드
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/android/.gradle/
frontend/android/app/debug/
frontend/android/app/release/
frontend/android/app/profile/
frontend/android/local.properties
frontend/android/key.properties
*.jks
*.keystore

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ──
# Docker 볼륨 데이터 (로컬 DB 데이터)
postgres_data/
redis_data/
# 루트의 data/만 무시한다. 앵커 없는 data/는 frontend/lib/features/*/data까지 무시해
# 새 repository 파일이 git status와 GitNexus 인덱스에서 사라졌다.
/data/
certbot/

# ── 업로드 파일 ──
uploads/
backend/uploads/

# ── 로그 ──
*.log
logs/

# ── OS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ── 기타 ──
*.bak
*.tmp
*.temp
node_modules/
codex_prompts/

# Local browser verification artifacts
.playwright-mcp/
ai-health-trainer-*.png

# ── Claude Code / Codex 하네스 ──
# 개인 설정(.claude/settings.local.json 등)은 제외하고 권한·역할·스킬만 추적한다
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
# 검증 증거 (scripts/verify.py)
.harness/
# GitNexus 코드 그래프 인덱스 (약 수백 MB, 워킹트리 기준으로 다시 만든다)
.gitnexus/
