{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "effortLevel": "xhigh",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.prod)",
      "Read(./.env.local)",
      "Read(./backend/.env)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)"
    ],
    "allow": [
      "Bash(python scripts/verify.py)",
      "Bash(python scripts/verify.py *)",
      "Bash(python scripts/harness.py *)",
      "Bash(python -m pytest tests *)",
      "Bash(python -m pytest tests/*)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose exec -T backend pytest *)",
      "Bash(docker compose exec -T backend python -m ruff check *)",
      "Bash(docker compose exec -T backend alembic heads)",
      "Bash(flutter analyze)",
      "Bash(flutter test)",
      "Bash(flutter test *)",
      "Bash(flutter run -d web-server *)",
      "Bash(gitnexus status)",
      "Bash(gitnexus list)",
      "Bash(gitnexus impact *)",
      "Bash(gitnexus context *)",
      "Bash(gitnexus query *)",
      "Bash(gitnexus trace *)",
      "Bash(gitnexus detect-changes *)",
      "Bash(gitnexus analyze)",
      "Bash(gitnexus analyze *)",
      "mcp__gitnexus__list_repos",
      "mcp__gitnexus__query",
      "mcp__gitnexus__context",
      "mcp__gitnexus__impact",
      "mcp__gitnexus__detect_changes",
      "mcp__gitnexus__trace",
      "mcp__gitnexus__explain"
    ]
  },
  "enabledMcpjsonServers": [
    "gitnexus"
  ]
}
